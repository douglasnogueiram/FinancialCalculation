          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/interest-accrual/summary",
              "host": ["{{baseUrl}}"],
              "path": ["interest-accrual", "summary"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dailyInterestRate\": 0.000660305482286683,\n  \"accrualDate\": \"2024-10-01\",\n  \"accrualBasis\": \"END_OF_PERIOD\",\n  \"repaymentSchedule\": {\n    \"installmentReference\": [0, 1, 2],\n    \"paymentDueDate\": [\n      \"2024-09-01\",\n      \"2024-10-01\",\n      \"2024-11-01\"\n    ],\n    \"paymentAmount\": [\n      50000.0000000,\n      2651.1922386,\n      2651.1922386\n    ]\n  }\n}",
